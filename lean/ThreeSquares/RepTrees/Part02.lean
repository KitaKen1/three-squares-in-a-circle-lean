theorem trees_check : ∀ T ∈ trees, T.tree.check T.code TBox.unit 0 = true := by
  intro T hT
  simp only [trees, List.mem_cons, List.not_mem_nil, or_false] at hT
  rcases hT with rfl | rfl | rfl | rfl
  · exact tree32_check
  · exact tree33_check
  · exact tree34_check
  · exact tree35_check

end ThreeSquares.CenterElimination.RepTrees.Part02
