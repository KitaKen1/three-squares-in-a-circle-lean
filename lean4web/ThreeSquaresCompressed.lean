      (rotation_difference_unit huv (rational_rotation_unit (P.t D.left)))))
    (turn_unit D.turnR (symmetric_unit D.g
      (rotation_difference_unit huv (rational_rotation_unit (P.t D.right))))) aL aRt ?_ (M '' Sq D.left) (M '' Sq D.right)
